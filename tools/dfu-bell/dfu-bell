#!/bin/sh
# The DFU bell: ring once when a person has to do something physical (put a
# device into DFU, replug it, unlock it). Plays ring.mp3 beside this script (six seconds), else the terminal bell.
sound=$(dirname "$0")/ring.mp3
if command -v afplay >/dev/null 2>&1; then exec afplay "$sound"
elif command -v paplay >/dev/null 2>&1; then exec paplay "$sound"
elif command -v ffplay >/dev/null 2>&1; then exec ffplay -nodisp -autoexit -loglevel quiet "$sound"
fi
printf '\a'
