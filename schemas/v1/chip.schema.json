{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchard chip facts v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "hardware.chip"
    },
    "cpid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "soc": {
      "type": "string",
      "pattern": "^[a-z0-9]+$"
    },
    "core": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "architecture": {
      "enum": [
        "arm",
        "arm64"
      ]
    },
    "page_size": {
      "enum": [
        4096,
        16384
      ]
    },
    "image_format": {
      "enum": [
        "img3",
        "im4p"
      ]
    },
    "platform": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "reference_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "iBSS",
          "iBEC"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "gpu": {
      "type": "object",
      "description": "GLES versions whose dEQP suite completes with no GPU hangs and only listed failures, run through Zink. A missing key means not reached.",
      "properties": {
        "gles2": {
          "const": "working"
        },
        "gles3": {
          "const": "working"
        },
        "gles31": {
          "const": "working"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "kind",
    "cpid",
    "name",
    "soc",
    "architecture",
    "image_format"
  ],
  "additionalProperties": false
}
