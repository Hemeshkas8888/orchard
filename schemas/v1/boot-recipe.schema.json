{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchard boot recipe v1",
  "description": "The Apple files a board's boot methods can use, and what a method can't derive itself.",
  "type": "object",
  "properties": {
    "schema": { "const": 1 },
    "device": { "type": "string", "pattern": "^[A-Za-z]+[0-9]+,[0-9]+$" },
    "firmware": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ipsw": {
            "type": "object",
            "properties": {
              "version": { "type": "string", "minLength": 1 },
              "build": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "pattern": "^(https://(updates\\.cdn-apple\\.com|secure-appldnld\\.apple\\.com)|http://appldnld\\.apple\\.com)/" },
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "required": ["version", "build", "url", "bytes", "sha256"],
            "additionalProperties": false
          },
          "selected_by": { "enum": ["chip-reference", "chip-reference-major", "firmware-recipe", "newest", "method"] },
          "inputs": {
            "type": "object",
            "properties": {
              "BuildManifest.plist": { "$ref": "#/$defs/input" },
              "iBSS": { "$ref": "#/$defs/input" },
              "iBEC": { "$ref": "#/$defs/input" },
              "DeviceTree": { "$ref": "#/$defs/input" }
            },
            "required": ["BuildManifest.plist", "iBSS"],
            "additionalProperties": { "$ref": "#/$defs/input" }
          }
        },
        "required": ["ipsw", "selected_by", "inputs"],
        "additionalProperties": false
      }
    },
    "methods": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "build": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        },
        "required": ["source"]
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "ipsw": {
          "type": "object",
          "properties": { "zip": { "type": "string", "minLength": 1 } },
          "required": ["zip"],
          "additionalProperties": false
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["ipsw", "sha256"],
      "additionalProperties": false
    }
  },
  "required": ["schema", "device", "firmware", "methods"],
  "additionalProperties": false
}
