#!/bin/sh
# orchard on PATH: runs the orchard checkout the current directory belongs to.
#
# Walking up from the current directory, the first match wins:
# - an orchard checkout (pyproject.toml of the project "orchard"): that checkout;
# - an orchard.local.toml with orchard = "PATH": the checkout at PATH, relative
#   to that file, e.g. your own clone or a worktree on a branch; or with
#   orchard = "nightly-YYYYMMDD-COMMIT" or "vX.Y.Z": that published version;
# otherwise the newest nightly: resolved once per command (nightly/latest.json),
# a shallow clone of its tag in the Orchard cache (tooling/NAME), so a command
# runs one version from start to end and the next one picks up a newer nightly.
# Offline, the newest nightly already in the cache. Until a nightly is
# published, or with ORCHARD_TOOLING=mainline: mainline, orchard's main branch
# cloned into the cache and changed only by `orchard update`.
#
# `orchard python ARGS` runs Python in that checkout's environment, for a
# distribution's own scripts; `orchard checkout` prints which checkout runs;
# `orchard update` updates mainline (a checkout of your own is yours: git).
set -eu

cache=${ORCHARD_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/orchard}

main=$cache/orchard-main
url=${ORCHARD_MAINLINE_URL:-https://github.com/OrchardLinux/orchard.git}
releases=${ORCHARD_RELEASES_URL:-https://github.com/OrchardLinux/orchard/releases/download}

# A published version (nightly-YYYYMMDD-COMMIT or vX.Y.Z), cloned once at its tag.
version() {
    dir=$cache/tooling/$1
    if [ ! -d "$dir/.git" ]; then
        mkdir -p "$cache/tooling"
        partial=$(mktemp -d "$cache/tooling/.$1.XXXXXX")
        echo "orchard: fetching $1" >&2
        if ! git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$1" "$url" "$partial/orchard" >&2; then
            rm -rf "$partial"
            echo "orchard: no orchard version $1" >&2
            exit 1
        fi
        mv "$partial/orchard" "$dir" 2>/dev/null || [ -d "$dir/.git" ]  # another command was first
        rm -rf "$partial"
    fi
    printf '%s\n' "$dir"
}

# The newest nightly, else (offline) the newest cached one, else mainline.
newest() {
    if [ "${ORCHARD_TOOLING:-}" = mainline ]; then
        mainline
        return
    fi
    name=$(curl -fsSL --max-time 20 "$releases/nightly/latest.json" 2>/dev/null |
        sed -n 's/.*"name": *"\(nightly-[0-9]\{8\}-[0-9a-f]\{12\}\)".*/\1/p')
    if [ -n "$name" ]; then
        version "$name"
        return
    fi
    cached=$(ls -d "$cache"/tooling/nightly-* 2>/dev/null | sort | tail -n 1)
    if [ -n "$cached" ]; then
        echo "orchard: no network; the newest cached nightly, $(basename "$cached")" >&2
        printf '%s\n' "$cached"
        return
    fi
    echo "orchard: no nightly published yet; mainline" >&2
    mainline
}

mainline() {
    if [ ! -d "$main/.git" ]; then
        mkdir -p "$cache"
        git clone --quiet "$url" "$main" >&2
    fi
    printf '%s\n' "$main"
}

update() {
    case $1 in
        "$cache"/tooling/*)
            # Commands already run the newest nightly; what update moves is this
            # launcher, which lives in mainline: to the same nightly.
            name=$(basename "$1")
            mainline >/dev/null
            if ! git -C "$main" diff --quiet HEAD; then
                echo "orchard: $main has local changes; not updating the launcher" >&2
                exit 1
            fi
            git -C "$main" fetch --quiet --depth 1 origin tag "$name"
            git -C "$main" -c advice.detachedHead=false checkout --quiet --detach "$name"
            echo "orchard runs $name, the newest nightly; the launcher is $name's" >&2
            return ;;
    esac
    if [ "$1" != "$main" ]; then
        echo "orchard runs your checkout $1; update it with git" >&2
        return
    fi
    if ! git -C "$main" diff --quiet HEAD; then
        echo "orchard: $main has local changes; not updating mainline" >&2
        exit 1
    fi
    before=$(git -C "$main" rev-parse --short HEAD)
    git -C "$main" fetch --quiet origin main
    git -C "$main" checkout --quiet --detach FETCH_HEAD
    after=$(git -C "$main" rev-parse --short HEAD)
    if [ "$before" = "$after" ]; then
        echo "mainline is up to date at $after"
    else
        echo "mainline $before -> $after"
    fi
}

checkout() {
    dir=$(pwd -P)
    while :; do
        if [ -f "$dir/pyproject.toml" ] && grep -qx 'name = "orchard"' "$dir/pyproject.toml"; then
            printf '%s\n' "$dir"
            return
        fi
        if [ -f "$dir/orchard.local.toml" ]; then
            path=$(sed -n 's/^orchard[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$dir/orchard.local.toml" | head -n 1)
            if [ -n "$path" ]; then
                if printf '%s' "$path" | grep -Eqx 'nightly-[0-9]{8}-[0-9a-f]{12}|v[0-9]+\.[0-9]+\.[0-9]+'; then
                    version "$path"
                    return
                fi
                case $path in
                    /*) ;;
                    "~/"*) path=$HOME/${path#"~/"} ;;
                    *) path=$dir/$path ;;
                esac
                [ -f "$path/pyproject.toml" ] || {
                    echo "orchard: $dir/orchard.local.toml names $path, which is not an orchard checkout" >&2
                    exit 1
                }
                (cd "$path" && pwd -P)
                return
            fi
        fi
        [ "$dir" = / ] && break
        dir=$(dirname "$dir")
    done
    newest
}

command -v uv >/dev/null 2>&1 || {
    echo 'orchard: install uv: https://docs.astral.sh/uv/getting-started/installation/' >&2
    exit 1
}
root=$(checkout)
export UV_PROJECT_ENVIRONMENT="$root/.venv"
# A launcher older than the nightly it runs says so once per command.
case $root in
    "$cache"/tooling/*)
        if [ "${1:-}" != update ] && ! cmp -s "$0" "$root/bin/orchard"; then
            echo "orchard: a newer launcher is in $(basename "$root"); run orchard update" >&2
        fi ;;
esac
case ${1:-} in
    checkout) printf '%s\n' "$root" ;;
    update) update "$root" ;;
    python) shift; exec uv run --quiet --project "$root" python "$@" ;;
    *) exec uv run --quiet --project "$root" orchard "$@" ;;
esac
