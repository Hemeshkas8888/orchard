From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Wed, 4 Nov 2026 08:38:02 +0800
Subject: [PATCH] cpuidle: Add a driver for Apple SoCs, for suspend-to-idle

Apple SoCs have no PSCI, so they run without a cpuidle driver and the idle
loop falls back to default_idle_call() before it looks at s2idle. On the
iPad 6 a suspend therefore kept the tick running and never suspended
timekeeping: CLOCK_MONOTONIC counted the sleep, and after a sleep of 669 s
systemd killed logind, userdbd and timesyncd for missing their 3 minute
watchdogs. PrepareForSleep(false) died with logind and NetworkManager stayed
asleep, with Wi-Fi off.

Add a driver with two WFI states. The core enters only a state above index 0
for s2idle, and only one with a non-zero exit latency. The arch timer's counter
is already marked as running through suspend, so the sleep is added to
CLOCK_BOOTTIME and the wall clock.

Bind only to T8010 for now: it changes the idle path, so a SoC is listed once
its suspend has been tested.

Assisted-by: LLM
---
 drivers/cpuidle/Kconfig.arm     |  7 ++++
 drivers/cpuidle/Makefile        |  1 +
 drivers/cpuidle/cpuidle-apple.c | 64 +++++++++++++++++++++++++++++++++
 3 files changed, 72 insertions(+)
 create mode 100644 drivers/cpuidle/cpuidle-apple.c

diff --git a/drivers/cpuidle/Kconfig.arm b/drivers/cpuidle/Kconfig.arm
index b88b01aa5829..0e25735bbca8 100644
--- a/drivers/cpuidle/Kconfig.arm
+++ b/drivers/cpuidle/Kconfig.arm
@@ -14,6 +14,13 @@ config ARM_CPUIDLE
 	  initialized by calling the CPU operations init idle hook
 	  provided by architecture code.
 
+config ARM_APPLE_CPUIDLE
+	bool "Apple SoC CPU idle driver"
+	depends on ARM64 && (ARCH_APPLE || COMPILE_TEST)
+	help
+	  Select this to give Apple SoCs, which have no PSCI, the idle state
+	  that suspend-to-idle needs to freeze the tick and suspend timekeeping.
+
 config ARM_PSCI_CPUIDLE
 	bool "PSCI CPU idle Driver"
 	depends on ARM_PSCI_FW
diff --git a/drivers/cpuidle/Makefile b/drivers/cpuidle/Makefile
index 88cbc2a7aea8..0fb4fd17c5ad 100644
--- a/drivers/cpuidle/Makefile
+++ b/drivers/cpuidle/Makefile
@@ -16,6 +16,7 @@ obj-$(CONFIG_HALTPOLL_CPUIDLE)		  += cpuidle-haltpoll.o
 ##################################################################################
 # ARM SoC drivers
 obj-$(CONFIG_ARM_MVEBU_V7_CPUIDLE) += cpuidle-mvebu-v7.o
+obj-$(CONFIG_ARM_APPLE_CPUIDLE)	+= cpuidle-apple.o
 obj-$(CONFIG_ARM_BIG_LITTLE_CPUIDLE)	+= cpuidle-big_little.o
 obj-$(CONFIG_ARM_CLPS711X_CPUIDLE)	+= cpuidle-clps711x.o
 obj-$(CONFIG_ARM_HIGHBANK_CPUIDLE)	+= cpuidle-calxeda.o
diff --git a/drivers/cpuidle/cpuidle-apple.c b/drivers/cpuidle/cpuidle-apple.c
new file mode 100644
index 000000000000..94a103d05a66
--- /dev/null
+++ b/drivers/cpuidle/cpuidle-apple.c
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CPU idle for Apple SoCs, which have no PSCI: WFI, twice.
+ *
+ * Without a cpuidle driver the idle loop never reaches the s2idle path, so
+ * suspend-to-idle keeps the tick running and does not suspend timekeeping:
+ * CLOCK_MONOTONIC counts the sleep, and every service watchdog armed before a
+ * long sleep expires on wake. The core only enters a state above index 0 for
+ * s2idle, and only one with a non-zero exit latency, hence the second state.
+ * It is the same WFI; both keep CPU state and the timers running, so the
+ * timer needs no broadcast.
+ */
+
+#include <linux/cpuidle.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/of.h>
+
+#include <asm/proc-fns.h>
+
+static __cpuidle int apple_cpuidle_wfi(struct cpuidle_device *dev,
+				       struct cpuidle_driver *drv, int index)
+{
+	cpu_do_idle();
+	return index;
+}
+
+static struct cpuidle_driver apple_cpuidle_driver = {
+	.name = "apple_cpuidle",
+	.owner = THIS_MODULE,
+	.states = {
+		{
+			.enter = apple_cpuidle_wfi,
+			.exit_latency = 1,
+			.target_residency = 1,
+			.name = "WFI",
+			.desc = "WFI",
+		},
+		{
+			.enter = apple_cpuidle_wfi,
+			.enter_s2idle = apple_cpuidle_wfi,
+			.exit_latency = 1,
+			.target_residency = 1000,
+			.name = "WFI-S2IDLE",
+			.desc = "WFI, for suspend-to-idle",
+		},
+	},
+	.state_count = 2,
+};
+
+/* The SoCs whose suspend-to-idle has been tested with this. */
+static const char *const apple_cpuidle_socs[] __initconst = {
+	"apple,t8010",
+	NULL
+};
+
+static int __init apple_cpuidle_init(void)
+{
+	if (!of_machine_compatible_match(apple_cpuidle_socs))
+		return -ENODEV;
+
+	return cpuidle_register(&apple_cpuidle_driver, NULL);
+}
+device_initcall(apple_cpuidle_init);
