From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 3 Nov 2026 00:53:10 +0800
Subject: [PATCH] dt-bindings: power: supply: apple,tristar-charger: Add the
 USB port link

The Tristar mux shares the USB data lines, and the USB device
controller cannot sense VBUS. The charger is the port's attach detector
and sets the controller's data role, holding USB data off until the
source is identified. Describe the link to the controller as an OF
graph port.

Assisted-by: LLM
---
 .../power/supply/apple,tristar-charger.yaml   | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/Documentation/devicetree/bindings/power/supply/apple,tristar-charger.yaml b/Documentation/devicetree/bindings/power/supply/apple,tristar-charger.yaml
index f976f460a..c839ad0ac 100644
--- a/Documentation/devicetree/bindings/power/supply/apple,tristar-charger.yaml
+++ b/Documentation/devicetree/bindings/power/supply/apple,tristar-charger.yaml
@@ -17,6 +17,11 @@ description: |
   leaves at 100 mA. PMU events come from the PMIC's event interrupt
   controller (the PMIC GPIO node).
 
+  The Tristar mux shares the USB data lines, and the USB device controller
+  cannot sense VBUS. The charger is therefore the port's attach detector: it
+  sets the data role of the USB controller linked through its port, holding
+  USB data off from attach until the source is identified.
+
 allOf:
   - $ref: power-supply.yaml#
 
@@ -58,6 +63,10 @@ properties:
   input-current-limit-microamp:
     description: Board maximum input current.
 
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description: Link to the USB controller whose role this charger sets.
+
 required:
   - compatible
   - reg
@@ -65,6 +74,7 @@ required:
   - interrupts
   - apple,tristar
   - input-current-limit-microamp
+  - port
 
 unevaluatedProperties: false
 
@@ -72,6 +82,16 @@ examples:
   - |
     #include <dt-bindings/interrupt-controller/irq.h>
 
+    usb {
+        usb-role-switch;
+
+        port {
+            usb_role: endpoint {
+                remote-endpoint = <&charger_usb>;
+            };
+        };
+    };
+
     i2c {
         #address-cells = <1>;
         #size-cells = <0>;
@@ -111,6 +131,12 @@ examples:
                          <77 IRQ_TYPE_EDGE_RISING>;
             apple,tristar = <&tristar>;
             input-current-limit-microamp = <2400000>;
+
+            port {
+                charger_usb: endpoint {
+                    remote-endpoint = <&usb_role>;
+                };
+            };
         };
     };
 ...
