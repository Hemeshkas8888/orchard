From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Wed, 4 Nov 2026 10:00:35 +0800
Subject: [PATCH 1/9] ASoC: max98357a: Allow the amplifier's TDM mode

MAX98357 also takes eight-slot TDM, where it picks its slot by the wiring
of SD_MODE and GAIN_SLOT at a fixed 12 dB gain. The DAI allows two channels
only, which makes a wider frame impossible through an ordinary card. Add a
"maxim,tdm" property that selects a DAI with up to eight channels and only
the 16 and 32 bit words TDM has. Boards without it keep the existing DAI.

Assisted-by: LLM
---
 .../bindings/sound/maxim,max98357a.yaml       |  7 +++++
 sound/soc/codecs/max98357a.c                  | 29 ++++++++++++++++++-
 2 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/sound/maxim,max98357a.yaml b/Documentation/devicetree/bindings/sound/maxim,max98357a.yaml
index 83ba8666fbb4..b97ce21d6458 100644
--- a/Documentation/devicetree/bindings/sound/maxim,max98357a.yaml
+++ b/Documentation/devicetree/bindings/sound/maxim,max98357a.yaml
@@ -36,6 +36,13 @@ properties:
       Delay time for SD_MODE pin changes intended to make I2S clocks ready
       before SD_MODE is unmuted in order to avoid the speaker pop noise.
 
+  maxim,tdm:
+    type: boolean
+    description:
+      The link runs in TDM mode, with up to eight slots. The amplifier selects
+      its slot by the wiring of its SD_MODE and GAIN_SLOT pins, at a fixed 12 dB
+      gain.
+
 required:
   - compatible
 
diff --git a/sound/soc/codecs/max98357a.c b/sound/soc/codecs/max98357a.c
index b0f8043fb9e2..18ae7121261c 100644
--- a/sound/soc/codecs/max98357a.c
+++ b/sound/soc/codecs/max98357a.c
@@ -119,8 +119,31 @@ static struct snd_soc_dai_driver max98357a_dai_driver = {
 	.ops    = &max98357a_dai_ops,
 };
 
+/* The amplifier picks its slot of the frame by SD_MODE and GAIN_SLOT. */
+static struct snd_soc_dai_driver max98357a_tdm_dai_driver = {
+	.name = "HiFi",
+	.playback = {
+		.stream_name	= "HiFi Playback",
+		.formats	= SNDRV_PCM_FMTBIT_S16 |
+					SNDRV_PCM_FMTBIT_S32,
+		.rates		= SNDRV_PCM_RATE_8000 |
+					SNDRV_PCM_RATE_16000 |
+					SNDRV_PCM_RATE_32000 |
+					SNDRV_PCM_RATE_44100 |
+					SNDRV_PCM_RATE_48000 |
+					SNDRV_PCM_RATE_88200 |
+					SNDRV_PCM_RATE_96000,
+		.rate_min	= 8000,
+		.rate_max	= 96000,
+		.channels_min	= 1,
+		.channels_max	= 8,
+	},
+	.ops    = &max98357a_dai_ops,
+};
+
 static int max98357a_platform_probe(struct platform_device *pdev)
 {
+	struct snd_soc_dai_driver *dai_driver;
 	struct max98357a_priv *max98357a;
 	int ret;
 
@@ -144,9 +167,13 @@ static int max98357a_platform_probe(struct platform_device *pdev)
 
 	dev_set_drvdata(&pdev->dev, max98357a);
 
+	dai_driver = &max98357a_dai_driver;
+	if (device_property_read_bool(&pdev->dev, "maxim,tdm"))
+		dai_driver = &max98357a_tdm_dai_driver;
+
 	return devm_snd_soc_register_component(&pdev->dev,
 			&max98357a_component_driver,
-			&max98357a_dai_driver, 1);
+			dai_driver, 1);
 }
 
 #ifdef CONFIG_OF
