From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 3 Nov 2026 02:44:44 +0800
Subject: [PATCH] usb: dwc2: drd: Hold a peripheral-only controller off with
 its pull-up

A peripheral-only controller with a role switch and no
role-switch-default-mode forced its B-valid session signal low through
the OTG override until a role was set. On the Apple A10 (iPad 6) that
left an interrupt pending which nothing cleared: as soon as binding the
gadget re-enabled interrupts, CPU 0 stayed in the interrupt handler (RCU
stall in dwc2_hsotg_udc_start) and USB never came up.

Such a controller now leaves the override alone. Without the device role
its pull-up stays off (DCTL.SFTDISCON): pullup() does not connect while
held, and setting the device role connects it. No role or the fallback
work behaves as before from the host's side.

Assisted-by: LLM
---
 drivers/usb/dwc2/core.h   |  3 +++
 drivers/usb/dwc2/drd.c    | 45 +++++++++++++++++++++++++++++++++++++--
 drivers/usb/dwc2/gadget.c |  4 +++-
 3 files changed, 49 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/dwc2/core.h b/drivers/usb/dwc2/core.h
index f736ea5..ae563ca 100644
--- a/drivers/usb/dwc2/core.h
+++ b/drivers/usb/dwc2/core.h
@@ -871,6 +871,8 @@ struct dwc2_hregs_backup {
  * @role_sw_fallback:	Connects a peripheral-only controller as a device if
  *			nothing sets a role in time
  * @role_sw_driven:	A role has been set through the role switch
+ * @role_sw_hold:	A peripheral-only controller without a default mode
+ *			holds its pull-up off: no role, or no device role, set
  * @hcd_enabled:	Host mode sub-driver initialization indicator.
  * @gadget_enabled:	Peripheral mode sub-driver initialization indicator.
  * @ll_hw_enabled:	Status of low-level hardware resources.
@@ -1076,6 +1078,7 @@ struct dwc2_hsotg {
 	struct mutex role_sw_lock;
 	struct delayed_work role_sw_fallback;
 	bool role_sw_driven;
+	bool role_sw_hold;
 	unsigned int hcd_enabled:1;
 	unsigned int gadget_enabled:1;
 	unsigned int ll_hw_enabled:1;
diff --git a/drivers/usb/dwc2/drd.c b/drivers/usb/dwc2/drd.c
index 890c207..c71b68b 100644
--- a/drivers/usb/dwc2/drd.c
+++ b/drivers/usb/dwc2/drd.c
@@ -91,11 +91,47 @@ static int dwc2_ovr_bvalid(struct dwc2_hsotg *hsotg, bool valid)
 	return 0;
 }
 
+/*
+ * A peripheral-only controller without a default mode: no session override.
+ * Forcing B-valid low on the Apple A10's controller left an interrupt
+ * pending that nothing cleared, and CPU 0 never left its handler. A role is
+ * the pull-up instead: held off (DCTL.SFTDISCON) until the device role.
+ */
+static bool dwc2_drd_soft_role(struct dwc2_hsotg *hsotg)
+{
+	return hsotg->dr_mode == USB_DR_MODE_PERIPHERAL &&
+	       hsotg->role_sw_default_mode == USB_DR_MODE_UNKNOWN;
+}
+
+static int dwc2_drd_set_soft_role(struct dwc2_hsotg *hsotg, enum usb_role role)
+{
+	unsigned long flags;
+
+	if (role == USB_ROLE_HOST)
+		return -EINVAL;
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	hsotg->role_sw_hold = role != USB_ROLE_DEVICE;
+	if (dwc2_is_device_enabled(hsotg)) {
+		if (hsotg->role_sw_hold)
+			dwc2_hsotg_core_disconnect(hsotg);
+		else
+			dwc2_hsotg_core_connect(hsotg);
+	}
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+
+	dev_dbg(hsotg->dev, "pull-up %s\n", hsotg->role_sw_hold ? "held off" : "released");
+	return 0;
+}
+
 static int dwc2_drd_set_role(struct dwc2_hsotg *hsotg, enum usb_role role)
 {
 	unsigned long flags;
 	int already = 0;
 
+	if (dwc2_drd_soft_role(hsotg))
+		return dwc2_drd_set_soft_role(hsotg, role);
+
 	/* Skip session not in line with dr_mode */
 	if ((role == USB_ROLE_DEVICE && hsotg->dr_mode == USB_DR_MODE_HOST) ||
 	    (role == USB_ROLE_HOST && hsotg->dr_mode == USB_DR_MODE_PERIPHERAL))
@@ -231,8 +267,13 @@ int dwc2_drd_init(struct dwc2_hsotg *hsotg)
 
 	hsotg->role_sw = role_sw;
 
-	/* Enable override and initialize values */
-	dwc2_ovr_init(hsotg);
+	if (dwc2_drd_soft_role(hsotg)) {
+		/* No session yet: the pull-up stays off until the device role */
+		hsotg->role_sw_hold = true;
+	} else {
+		/* Enable override and initialize values */
+		dwc2_ovr_init(hsotg);
+	}
 
 	if (hsotg->dr_mode == USB_DR_MODE_PERIPHERAL &&
 	    hsotg->role_sw_default_mode == USB_DR_MODE_UNKNOWN)
diff --git a/drivers/usb/dwc2/gadget.c b/drivers/usb/dwc2/gadget.c
index 0dc6eee..81dea78 100644
--- a/drivers/usb/dwc2/gadget.c
+++ b/drivers/usb/dwc2/gadget.c
@@ -4706,7 +4706,9 @@ static int dwc2_hsotg_pullup(struct usb_gadget *gadget, int is_on)
 		dwc2_hsotg_core_init_disconnected(hsotg, false);
 		/* Enable ACG feature in device mode,if supported */
 		dwc2_enable_acg(hsotg);
-		dwc2_hsotg_core_connect(hsotg);
+		/* A held role switch connects it later (drd.c) */
+		if (!hsotg->role_sw_hold)
+			dwc2_hsotg_core_connect(hsotg);
 	} else {
 		dwc2_hsotg_core_disconnect(hsotg);
 		dwc2_hsotg_disconnect(hsotg);
-- 
2.54.0 (Apple Git-157)

