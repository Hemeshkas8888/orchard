From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 3 Nov 2026 00:53:10 +0800
Subject: [PATCH] arm64: dts: apple: ipad5, ipad6: Let the Lightning charger
 set the USB role

Link the Tristar charger to the USB device controller with an OF graph
and make the controller a role switch, so USB data stays off until the
attached source is identified. The iPad 7 has no Tristar charger and
drops the link.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/s800x-ipad5.dtsi | 19 ++++++++++++++++++-
 arch/arm64/boot/dts/apple/t8010-ipad6.dtsi | 19 ++++++++++++++++++-
 arch/arm64/boot/dts/apple/t8010-ipad7.dtsi |  2 ++
 3 files changed, 38 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi b/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
index abb6ea2b1..09f52de07 100644
--- a/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
+++ b/arch/arm64/boot/dts/apple/s800x-ipad5.dtsi
@@ -205,6 +205,13 @@ tristar_charger: charger@180 {
 				     <77 IRQ_TYPE_EDGE_RISING>;
 			apple,tristar = <&tristar>;
 			input-current-limit-microamp = <2400000>;
+
+			/* The charger decides when USB data may come on. */
+			port {
+				tristar_charger_usb: endpoint {
+					remote-endpoint = <&usbdev_role>;
+				};
+			};
 		};
 
 		rtc@500 {
@@ -453,7 +460,17 @@ &wlan_uart2 {
 
 #endif /* S800X_IPAD5_PCIE */
 
-/* Tell the Lightning charger what the USB host allows. */
+/*
+ * The Lightning charger sets the data role: USB data stays off until the
+ * source is identified. It is told what the USB host allows.
+ */
 &usbdev {
 	usb-psy-name = "lightning";
+	usb-role-switch;
+
+	port {
+		usbdev_role: endpoint {
+			remote-endpoint = <&tristar_charger_usb>;
+		};
+	};
 };
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index b6d6affe2..924434224 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -136,6 +136,13 @@ tristar_charger: charger@180 {
 				     <77 IRQ_TYPE_EDGE_RISING>;
 			apple,tristar = <&tristar>;
 			input-current-limit-microamp = <2400000>;
+
+			/* The charger decides when USB data may come on. */
+			port {
+				tristar_charger_usb: endpoint {
+					remote-endpoint = <&usbdev_role>;
+				};
+			};
 		};
 
 		nvmem@5000 {
@@ -274,9 +281,19 @@ &sio {
 	status = "okay";
 };
 
-/* Tell the Lightning charger what the USB host allows. */
+/*
+ * The Lightning charger sets the data role: USB data stays off until the
+ * source is identified. It is told what the USB host allows.
+ */
 &usbdev {
 	usb-psy-name = "lightning";
+	usb-role-switch;
+
+	port {
+		usbdev_role: endpoint {
+			remote-endpoint = <&tristar_charger_usb>;
+		};
+	};
 };
 
 &wlan_uart2 {
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
index 3401688fd..8d3fa0467 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad7.dtsi
@@ -25,6 +25,8 @@ aliases {
 
 &usbdev {
 	/delete-property/ usb-psy-name;
+	/delete-property/ usb-role-switch;
+	/delete-node/ port;
 };
 
 /* The PMU event line of the iPad 7 is not described yet. */
