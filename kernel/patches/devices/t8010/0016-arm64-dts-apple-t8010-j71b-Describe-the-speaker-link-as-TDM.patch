From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Wed, 4 Nov 2026 10:00:36 +0800
Subject: [PATCH 3/9] arm64: dts: apple: t8010-j71b: Describe the speaker link
 as TDM

iOS runs the J71b's amplifiers as eight slots of 16 bits with a 1-bit sync
and one bit of data delay, which is ASoC's "dsp_a". No other board changes.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8010-j71b.dts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8010-j71b.dts b/arch/arm64/boot/dts/apple/t8010-j71b.dts
index 63e85734405d..9b87b385b268 100644
--- a/arch/arm64/boot/dts/apple/t8010-j71b.dts
+++ b/arch/arm64/boot/dts/apple/t8010-j71b.dts
@@ -16,13 +16,14 @@ / {
 	speaker_amps: amplifier {
 		compatible = "maxim,max98357a";
 		#sound-dai-cells = <0>;
+		maxim,tdm;
 		sdmode-gpios = <&pinctrl_ap 20 GPIO_ACTIVE_HIGH>;
 	};
 
 	sound {
 		compatible = "simple-audio-card";
 		simple-audio-card,name = "J71b Speakers";
-		simple-audio-card,format = "i2s";
+		simple-audio-card,format = "dsp_a";
 		simple-audio-card,bitclock-master = <&speaker_cpu>;
 		simple-audio-card,frame-master = <&speaker_cpu>;
 		simple-audio-card,widgets = "Speaker", "Speakers";
